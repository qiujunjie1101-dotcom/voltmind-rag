# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不会入库，禁止提交真实密钥。
# 进程环境变量优先级高于本文件。

# DeepSeek API Key，可选。留空时内置供应商不可用，但「设置 → 模型服务」里
# 配置的自定义供应商仍可正常问答；两者都没有时 /api/v1/chat 返回 503。
DEEPSEEK_API_KEY=

# 允许跨域访问的前端来源，逗号分隔。默认只放行本地开发地址：
#   127.0.0.1 / localhost 的 5174（voltmind-web）与 5173（ai-workspace）及 4173（preview）
# 部署到其他域名时必须显式补充，不支持通配符。
# CORS_ALLOW_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# 以下均为可选，留空或删除则使用代码内默认值。
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0.7

# 自定义供应商密钥的加密主口令。部署环境必须显式设置，长度不限。
# 未设置时首次启动自动生成 data/.secret_key（仅本地开发用）；
# 更换主口令会导致已保存的密钥无法解密，需要在界面上重新填写。
# VOLTMIND_SECRET_KEY=change-me-in-production

# 自定义 Base URL 默认禁止指向内网与保留地址（防 SSRF）。
# 使用本机自建推理服务（Ollama、LM Studio 等）时改为 true。
# ALLOW_PRIVATE_BASE_URLS=false

# 供应商配置与密钥的存放位置，默认 ai-service/data/ 下，该目录不入库。
# DATA_DIR=./data
# PROVIDER_STORE_PATH=./data/model_providers.json
# SECRET_KEY_PATH=./data/.secret_key

# 服务自身配置
# APP_NAME=voltmind-ai-service
# APP_ENV=local
# HOST=127.0.0.1
# PORT=8000
