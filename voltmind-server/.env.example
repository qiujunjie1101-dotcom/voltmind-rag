# Set these in the process environment; Spring Boot does not read this file automatically.
# Create the database once with a dedicated account before starting the service.
DB_HOST=127.0.0.1
DB_PORT=13306
DB_NAME=voltmind
DB_USERNAME=voltmind
DB_PASSWORD=replace-with-local-password
MYSQL_ROOT_PASSWORD=replace-with-another-local-password
# SPRING_PROFILES_ACTIVE=local
# SERVER_PORT=8080
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# Local document storage. Relative paths are resolved from voltmind-server/.
# FILE_STORAGE_ROOT=./data/uploads
# MAX_FILE_SIZE_BYTES=20971520
# MAX_FILE_SIZE=20MB
